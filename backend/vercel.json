{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "src/**"
    }
  },
  "crons": [{ "path": "/api/cron/daily", "schedule": "0 5 * * *" }]
}
