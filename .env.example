# ============================================================
# TAT Agency System — Environment Variables
# Copy this file to `.env` and fill in real values before running
# `docker-compose up`. Never commit your actual .env file.
# ============================================================

# --- Database ---
DB_USER=tat_user
DB_PASSWORD=change_this_password
DB_NAME=tat_agency
DB_PORT=5432

# --- Backend ---
# Generate a long random string for JWT_SECRET, e.g.:
#   openssl rand -base64 48
JWT_SECRET=change_this_to_a_long_random_secret
BACKEND_PORT=4000

# Initial admin account (auto-created on first startup if it
# doesn't already exist). Log in with these, then add the rest
# of the team from inside the app (Admin > Team, once you build
# that screen) or via the /api/auth/users endpoint.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@tatagency.com
ADMIN_PASSWORD=change_this_password

# --- Multi-agency / email / webhooks (all optional; see docs/EMAIL-WEBHOOKS.md) ---
# Who becomes the platform owner (Super Admin). Defaults to ADMIN_EMAIL.
PLATFORM_ADMIN_EMAIL=
# Public address of the app, used in invitation / password-reset links, e.g. https://app.example.com
APP_URL=
# Key used to encrypt SMTP passwords at rest. Defaults to JWT_SECRET. Changing it later means re-entering SMTP passwords.
SECRETS_KEY=
# Optional comma-separated allow-list of browser origins for the API.
CORS_ORIGIN=
# Platform-wide SMTP fallback (can also be set from the Platform admin screen).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=

# --- Frontend ---
FRONTEND_PORT=8080

# --- Hosted deployment (Vercel frontend + separate backend/DB) — see docs/DEPLOY-VERCEL.md ---
# Backend: one connection string instead of DB_HOST/DB_USER/..., and TLS for managed Postgres.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# Neon: DATABASE_URL = pooled string (app queries), DATABASE_URL_UNPOOLED = direct string (migrations only)
# DATABASE_URL_UNPOOLED=postgres://user:pass@host:5432/dbname
# DB_SSL=true
# Backend: the exact origin of the Vercel site (comma-separated list), e.g. https://app.example.com
# CORS_ORIGIN=https://your-app.vercel.app
# Frontend (set in Vercel project settings, used at BUILD time): public URL of the backend, no trailing slash
# VITE_API_URL=https://api.example.com
